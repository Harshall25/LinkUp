# Copy this file to .env for local dev; production values go into
# Cloud Run environment variables / Secret Manager, not this file.

# HTTP port. Cloud Run overrides this at runtime — leave 8080 for local.
PORT=8080

# Mongo connection string used by config/database.js
MONGO_URI=mongodb://localhost:27017/linkup

# JWT signing secret. Rotate before shipping.
JWT_SECRET=change-me

# Cloudflare R2 credentials (media uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
