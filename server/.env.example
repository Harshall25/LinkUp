# Copy this file to .env for local dev. In production, set the same keys in
# Vercel → Project → Settings → Environment Variables.

# HTTP port for local dev (the Vite proxy reads this to find the API).
PORT=3000

# MongoDB connection string used by config/database.js
MONGODB_URI=mongodb://localhost:27017/linkup

# JWT signing secret. Use a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. Leave empty to hide
# the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# Cloudflare R2 credentials (media uploads). The bucket can stay private:
# the API hands out short-lived signed URLs for uploads and playback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
