# Copy to .env.development for local dev and to .env.production before
# building for Firebase Hosting. Both are gitignored.
#
# When VITE_API_URL is unset, the app defaults to "/api/v1", which is served
# by the Vite dev proxy in development and by the Firebase rewrite in prod.
# Only set this to a full origin if you want to bypass the proxy/rewrite.
VITE_API_URL=

# Vite dev proxy target. Change if your local backend is not on 8080.
VITE_DEV_PROXY_TARGET=http://localhost:8080
